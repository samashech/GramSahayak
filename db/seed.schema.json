{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gramsahayak.local/schemas/seed.schema.json",
  "title": "GramSahayak Scheme Seed Corpus (Contract v1 Section 5)",
  "description": "Validates /data/seed/schemes.json (array of 13 self-contained scheme cards).",
  "type": "array",
  "minItems": 13,
  "maxItems": 13,
  "items": {
    "$ref": "#/$defs/SchemeCard"
  },
  "$defs": {
    "SchemeCode": {
      "type": "string",
      "enum": [
        "PMKISAN",
        "PMFBY",
        "KCC",
        "SHC",
        "PMJAY",
        "JSY",
        "PMMVY",
        "MGNREGA",
        "UJJWALA",
        "PMAY",
        "NSP",
        "PMYASASVI",
        "PRAGATI"
      ]
    },
    "SmsText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "SchemeCard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "name_en",
        "name_hi",
        "name_mr",
        "name_ta",
        "category",
        "target_role",
        "benefits",
        "eligibility",
        "exclusions",
        "documents",
        "how_to_apply",
        "helpline",
        "portal_url",
        "sms_summary",
        "rules"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/SchemeCode"
        },
        "code": {
          "$ref": "#/$defs/SchemeCode"
        },
        "name_en": {
          "type": "string",
          "minLength": 1
        },
        "name_hi": {
          "type": "string",
          "minLength": 1
        },
        "name_mr": {
          "type": "string",
          "minLength": 1
        },
        "name_ta": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": ["schemes", "agri", "health", "education"]
        },
        "target_role": {
          "type": "string",
          "enum": ["farmer", "asha", "panchayat", "student"]
        },
        "benefits": {
          "type": "string",
          "minLength": 1
        },
        "eligibility": {
          "type": "string",
          "minLength": 1
        },
        "exclusions": {
          "type": "string",
          "minLength": 1
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "how_to_apply": {
          "type": "string",
          "minLength": 1
        },
        "helpline": {
          "type": "string",
          "minLength": 1
        },
        "portal_url": {
          "type": "string",
          "pattern": "^https://[^\\s/$.?#].[^\\s]*$"
        },
        "sms_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["en-IN", "hi-IN", "mr-IN", "ta-IN"],
          "properties": {
            "en-IN": { "$ref": "#/$defs/SmsText" },
            "hi-IN": { "$ref": "#/$defs/SmsText" },
            "mr-IN": { "$ref": "#/$defs/SmsText" },
            "ta-IN": { "$ref": "#/$defs/SmsText" },
            "gu-IN": { "$ref": "#/$defs/SmsText" }
          }
        },
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "occupations",
            "max_land_hectares",
            "bpl_only",
            "gender",
            "pregnant_only",
            "min_age",
            "max_age",
            "max_annual_income",
            "social_categories"
          ],
          "properties": {
            "occupations": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "enum": [
                      "farmer",
                      "agri_labourer",
                      "daily_wage",
                      "student",
                      "homemaker",
                      "other"
                    ]
                  }
                }
              ]
            },
            "max_land_hectares": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1000
                }
              ]
            },
            "bpl_only": {
              "type": "boolean"
            },
            "gender": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "string",
                  "enum": ["male", "female", "other"]
                }
              ]
            },
            "pregnant_only": {
              "type": "boolean"
            },
            "min_age": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 120
                }
              ]
            },
            "max_age": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 120
                }
              ]
            },
            "max_annual_income": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 1000000000
                }
              ]
            },
            "social_categories": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "enum": ["general", "obc", "sc", "st"]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
