# GramSahayak root environment (contract section 10).
# Copy to .env (never committed). Frontend uses frontend/.env.local.

# ---- Node gateway :5000 ----
PORT=5000
# Comma-separated list allowed, e.g. http://localhost:3000,https://gramsahayak.vercel.app
FRONTEND_ORIGIN=http://localhost:3000
AI_RAG_URL=http://localhost:8000
APP_ENV=development
DEMO_MODE=true
TRANSLATE_PIVOT=false
USE_MOCK_AI=false

# ---- Database (postgres | sqlite | memory) ----
DB_DRIVER=memory
# Supabase pooler, transaction mode, port 6543
DATABASE_URL=
SQLITE_PATH=data/gram_sahayak.sqlite

# ---- AI providers ----
SARVAM_API_KEY=
# Groq key, shared by Node and RAG
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
# Groq free tier: 8,000 tokens/min per model -> fall back to other models on 429 (DEC-16)
LLM_FALLBACK_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b
LLM_REASONING_EFFORT=none
LLM_CONTEXT_CHUNKS=2
LLM_MAX_TOKENS_VOICE=220
LLM_MAX_TOKENS_TEXT=450
# Speech-to-text when SARVAM_API_KEY is empty: Groq Whisper with LLM_API_KEY (DEC-17)
GROQ_STT_MODEL=whisper-large-v3

# ---- CloudTalk ----
CLOUDTALK_API_KEY_ID=
CLOUDTALK_API_SECRET=
CLOUDTALK_WEBHOOK_SECRET=

# ---- RAG :8000 ----
EMBED_MODEL=intfloat/multilingual-e5-small
CHROMA_DIR=rag/chroma_db
RAG_TOP_K=4
RAG_MATCH_THRESHOLD=0.80
MOCK_LLM=false

# ---- Frontend (copy into frontend/.env.local) ----
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_USE_MOCKS=false
