{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gramsahayak.local/schemas/demo_personas.schema.json",
  "title": "GramSahayak Demo Personas (Contract v1 Section 12 + CCR-04 starter_history)",
  "description": "Validates /data/seed/demo_personas.json (5 judge demo presets for x-demo-user, including 2 starter web Turn objects each).",
  "type": "array",
  "minItems": 5,
  "maxItems": 5,
  "items": {
    "$ref": "#/$defs/DemoPersona"
  },
  "$defs": {
    "LanguageCode": {
      "type": "string",
      "enum": [
        "hi-IN",
        "mr-IN",
        "ta-IN",
        "en-IN",
        "te-IN",
        "bn-IN",
        "gu-IN",
        "kn-IN",
        "ml-IN",
        "pa-IN",
        "od-IN"
      ]
    },
    "StarterTurn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ts",
        "channel",
        "speaker",
        "text",
        "category",
        "language"
      ],
      "properties": {
        "ts": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        },
        "channel": {
          "type": "string",
          "const": "web"
        },
        "speaker": {
          "type": "string",
          "enum": ["user", "assistant"]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": ["string", "null"],
          "enum": ["schemes", "agri", "health", "education", null]
        },
        "language": {
          "$ref": "#/$defs/LanguageCode"
        }
      }
    },
    "DemoPersona": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "phone",
        "name",
        "role",
        "language",
        "occupation",
        "land_hectares",
        "bpl",
        "age",
        "gender",
        "pregnant",
        "annual_income",
        "social_category",
        "starter_history"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "farmer-hi",
            "farmer-mr",
            "asha-ta",
            "student-hi",
            "panchayat-hi"
          ]
        },
        "phone": {
          "type": "string",
          "pattern": "^\\+91[0-9]{10}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": ["farmer", "asha", "panchayat", "student"]
        },
        "language": {
          "$ref": "#/$defs/LanguageCode"
        },
        "occupation": {
          "type": "string",
          "enum": [
            "farmer",
            "agri_labourer",
            "daily_wage",
            "student",
            "homemaker",
            "other"
          ]
        },
        "land_hectares": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "bpl": {
          "type": "boolean"
        },
        "age": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120
        },
        "gender": {
          "type": "string",
          "enum": ["male", "female", "other"]
        },
        "pregnant": {
          "type": "boolean"
        },
        "annual_income": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "social_category": {
          "type": "string",
          "enum": ["general", "obc", "sc", "st"]
        },
        "starter_history": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/StarterTurn"
          }
        }
      }
    }
  }
}
